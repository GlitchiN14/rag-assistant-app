# Copy this file to .env and adjust if needed.
APP_NAME=Cybersecurity Guidelines Assistant
LOG_LEVEL=INFO

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
TEMPERATURE=0.1

# Retrieval
VECTOR_STORE_DIR=data/vector_store
TOP_K=4
# If the BEST-matching chunk has a cosine distance above this, the question is treated
# as out of scope and the assistant refuses without calling the LLM.
# In the evaluation: in-scope questions scored 0.22-0.35, out-of-scope 0.45-0.84.
MAX_DISTANCE=0.60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
